# ====================================================================
# BUILDASSET LOGISTICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values for your environment.
# Never commit active secrets or production credentials to source control.
# ====================================================================

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=buildasset_db
DB_USERNAME=postgres
DB_PASSWORD=your_password

# Spring Datasource URLs (Automatic schema routing per microservice)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password

# Service Discovery & Ports
EUREKA_SERVER_URL=http://localhost:8761/eureka/
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8085
CONTRACTOR_SERVICE_PORT=8081
EQUIPMENT_SERVICE_PORT=8082
RENTAL_SERVICE_PORT=8083
DISPATCH_SERVICE_PORT=8084
FRONTEND_PORT=5173

# Security & Stateless JWT Authentication (Must be at least 256-bit / 32-chars)
JWT_SECRET=BuildAssetLogisticsSuperSecretKeyForJWTAuthentication2026Enterprise
JWT_EXPIRATION_MS=86400000

# Frontend Gateway URL
VITE_API_BASE_URL=http://localhost:8080
